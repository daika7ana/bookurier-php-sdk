{
    "name": "daika7ana/bookurier-php-sdk",
    "description": "Typed PHP SDK for the Bookurier courier services API.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "bookurier",
        "courier",
        "shipping",
        "awb",
        "sdk",
        "api",
        "psr-18"
    ],
    "homepage": "https://github.com/daika7ana/bookurier-php-sdk",
    "support": {
        "issues": "https://github.com/daika7ana/bookurier-php-sdk/issues",
        "source": "https://github.com/daika7ana/bookurier-php-sdk",
        "docs": "https://github.com/daika7ana/bookurier-php-sdk#readme"
    },
    "autoload": {
        "psr-4": {
            "Daika7ana\\Bookurier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daika7ana\\Bookurier\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dan-Radu Pana"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-client": "^1.0",
        "daika7ana/simple-collections": "^1.0",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "guzzlehttp/psr7": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0 || ^13.0",
        "laravel/pint": "^1.29",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "pint": "@php vendor/bin/pint --test",
        "stan": "@php vendor/bin/phpstan --no-progress",
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit tests/Unit",
        "test:smoke": "@php vendor/bin/phpunit tests/Smoke",
        "ci": [
            "composer validate --strict",
            "@pint",
            "@stan",
            "@test:unit"
        ]
    }
}
